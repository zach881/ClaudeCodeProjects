# Anthropic API key powering the SEO + Content Strategist agents.
# Get one at https://console.anthropic.com/ — the agents use claude-opus-4-8.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (defaults to claude-opus-4-8).
# ZERVE_AGENT_MODEL=claude-opus-4-8

# Optional: where run history is persisted (defaults to ./.data).
# ZERVE_DATA_DIR=./.data

# ---- Outreach agent: Clay enrichment (optional) ----
# Connects the Outreach agent to Clay's tools via the Anthropic MCP connector.
# Without these, enrichment falls back to public web search (no contact emails).
# CLAY_MCP_URL=https://...
# CLAY_MCP_AUTH_TOKEN=...

# ---- SEO measured data (optional) ----
# When set, replaces the SEO agent's qualitative estimates with real metrics.
# AHREFS_API_TOKEN=...           # search volume + keyword difficulty
# GSC_ACCESS_TOKEN=...           # Google Search Console OAuth/service-account token
# GSC_SITE_URL=https://zerve.io/ # the verified Search Console property
# SEO_COUNTRY=us                 # country code for volume/difficulty
